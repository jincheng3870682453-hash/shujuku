# ──────────────────────────
# 动态数据登记系统 - 环境变量配置
# 复制此文件为 .env 后修改
# ──────────────────────────

# 数据库引擎：sqlite 或 mysql
DB_ENGINE=sqlite

# SQLite 配置（仅 DB_ENGINE=sqlite 时使用）
SQLITE_PATH=./data/app.db

# MySQL 配置（仅 DB_ENGINE=mysql 时使用）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=app_db

# Flask 配置
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5001

# 前端 API 地址（开发模式使用）
VITE_API_BASE_URL=http://localhost:5001/api

# Docker MySQL 密码（仅 docker-compose 使用）
MYSQL_ROOT_PASSWORD=root123456
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass123